# MandiSaathi Backend Environment Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mandisaathi
DB_USER=mandisaathi
DB_PASSWORD=mandisaathi_secret
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gnani Voice AI Interfaces
GNANI_ENABLED=false
GNANI_API_KEY=
GNANI_STT_URL=https://api.gnani.ai/v2.5/stt
GNANI_TTS_URL=https://api.gnani.ai/v2.5/tts
GNANI_TIMEOUT_MS=10000

