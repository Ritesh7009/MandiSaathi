# MandiSaathi - Root Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mandisaathi
DB_USER=mandisaathi
DB_PASSWORD=mandisaathi_secret
POSTGRES_HOST_PORT=5433

# Backend Server Configuration
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Gnani Voice AI (Prisma v2.5 STT, Timbre v2.5 TTS)
# Note: Keep credentials secure on the backend. Never expose in frontend code.
# One GNANI_API_KEY with both STT and TTS scopes authenticated via X-API-Key-ID header.
GNANI_ENABLED=false
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TIMEOUT_MS=10000
GNANI_TTS_VOICE_HINDI=Nalini
GNANI_TTS_VOICE_PUNJABI=Nalini
GNANI_TTS_VOICE_ENGLISH=Kaveri

# Administrative Key for Grievance Registry Access
ADMIN_API_KEY=your_secure_admin_api_key_here

MANDI_DATA_ENABLED=false
MANDI_DATA_SCHEDULE_ENABLED=false
MANDI_DATA_CRON=0 0 19 * * *
MANDI_DATA_ZONE=Asia/Kolkata
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MANDI_DATA_LIMIT=100
MANDI_DATA_TIMEOUT_MS=15000

