# MandiSaathi - Root Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mandisaathi
DB_USER=mandisaathi
DB_PASSWORD=mandisaathi_secret
POSTGRES_HOST_PORT=5433

# Backend Server Configuration
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Gnani Voice AI (Prisma v2.5 STT, Timbre v2.5 TTS)
# Note: Keep credentials secure on the backend. Never expose in frontend code.
GNANI_ENABLED=false
GNANI_API_KEY=
GNANI_STT_URL=https://api.gnani.ai/v2.5/stt
GNANI_TTS_URL=https://api.gnani.ai/v2.5/tts
GNANI_TIMEOUT_MS=10000

